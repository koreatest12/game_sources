# Required: DNS A/AAAA record must point this hostname to the production server.
DOMAIN=game.example.com
ACME_EMAIL=admin@example.com

# Optional image name. Local build is used by default.
GAME_IMAGE=game-sources:prod

# Optional JVM tuning.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# SSH port used by firewall/deployment scripts.
SSH_PORT=22
